# Copy to /etc/battle-royal/env on the EC2 instance and fill in. Never commit the real one.
#   sudo install -m 600 -o root -g root /dev/null /etc/battle-royal/env
DB_URL=jdbc:mysql://<rds-endpoint>:3306/battleroyal?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=battleroyal
DB_PASSWORD=<password>
# Google OAuth client (Google Cloud Console). The secret never goes in the repository.
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>
